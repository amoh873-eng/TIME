@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization

<div class="clock-card rounded-4 p-4 mt-5">
    <div class="d-flex align-items-center gap-3 mb-2">
        <span class="display-6">🕐</span>
        <h2 class="h5 mb-0">الوقت الآن</h2>
    </div>
    <p class="clock-time fs-2 mb-1" dir="ltr">@timeText</p>
    <p class="text-muted mb-3">@dateText</p>
    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="Refresh">🔄 تحديث الوقت</button>
</div>

@code {
    private static readonly CultureInfo Arabic = CultureInfo.GetCultureInfo("ar-EG");
    private System.Threading.Timer? timer;
    private String timeText = "";
    private String dateText = "";

    protected override void OnInitialized()
    {
        Refresh();
        // تحديث تلقائي كل ثانية لعرض ساعة حيّة.
        timer = new System.Threading.Timer(
            _ => OnTick(),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));
    }

    private void OnTick()
    {
        _ = InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        DateTime now = DateTime.Now;
        timeText = now.ToString("HH:mm:ss", Arabic);
        dateText = now.ToString("dddd، d MMMM yyyy", Arabic);
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}
