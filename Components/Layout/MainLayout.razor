@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="text-muted">تطبيق إدارة المهام والوقت — ASP.NET Core · Razor · Blazor</span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    حدث خطأ غير متوقع أثناء معالجة الطلب.
    <a href="." class="reload">إعادة التحميل</a>
    <span class="dismiss">🗙</span>
</div>
