@page "/tasks"
@rendermode InteractiveServer

@using time.Models
@using time.Services
@using System.Collections

<PageTitle>المهام — Time</PageTitle>

<h1 class="mb-3">📋 مهامي</h1>

@if (message.Length != 0)
{
    <div class="alert alert-success py-2" role="status">@message</div>
}

<div class="d-flex flex-wrap gap-2 my-3">
    <span class="badge text-bg-primary fs-6">إجمالي المهام: @totalCount</span>
    <span class="badge text-bg-success fs-6">مكتملة: @doneCount</span>
    <span class="badge text-bg-warning fs-6">المتبقية: @remainingCount</span>
</div>

<form class="row g-2 mt-3" @onsubmit="AddTask">
    <div class="col-12 col-sm-7">
        <label class="visually-hidden" for="newTaskTitle">عنوان المهمة</label>
        <input id="newTaskTitle" type="text" class="form-control" placeholder="عنوان المهمة..." maxlength="200" required @bind="newTitle" />
    </div>
    <div class="col-12 col-sm-5">
        <label class="visually-hidden" for="newTaskNotes">ملاحظات</label>
        <input id="newTaskNotes" type="text" class="form-control" placeholder="ملاحظات (اختياري)..." maxlength="300" @bind="newNotes" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary px-4">➕ إضافة مهمة</button>
    </div>
</form>

@if (tasks.Length == 0)
{
    <div class="border rounded p-4 mt-4 text-center text-muted">
        لا توجد مهام بعد — أضف مهمتك الأولى من النموذج أعلاه! 🎉
    </div>
}
else
{
    <ul class="list-group mt-4">
        @foreach (var task in tasks)
        {
            <TaskRow Item="(TodoItem) task" />
        }
    </ul>
}

@code {
    private readonly TaskRepository repository = TaskRepository.shared();
    private Object?[] tasks = new Object[0];
    private String newTitle = "";
    private String newNotes = "";
    private String message = "";
    private int totalCount = 0;
    private int doneCount = 0;
    private int remainingCount = 0;

    protected override void OnInitialized()
    {
        Reload();
    }

    private void AddTask()
    {
        if (newTitle.Trim().Length == 0)
        {
            return;
        }
        repository.Add(newTitle.Trim(), newNotes.Trim());
        newTitle = "";
        newNotes = "";
        message = "تمت إضافة المهمة بنجاح ✓";
        Reload();
    }

    private void Reload()
    {
        ArrayList undone = new ArrayList();
        ArrayList done = new ArrayList();
        Object?[] all = repository.All();
        for (int i = 0; i < all.Length; i++)
        {
            TodoItem t = (TodoItem) all[i];
            if (t.done)
            {
                done.Add(t);
            }
            else
            {
                undone.Add(t);
            }
        }
        for (int i = 0; i < done.Count; i++)
        {
            undone.Add(done.ToArray()[i]);
        }
        tasks = undone.ToArray();
        totalCount = tasks.Length;
        doneCount = done.Count;
        remainingCount = totalCount - doneCount;
    }
}